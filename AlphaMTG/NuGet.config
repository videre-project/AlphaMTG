<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!-- The SDK build writes its development packages here. The compose
         mount exposes the same relative path inside the AlphaMTG container. -->
    <add key="mtgosdk" value="../../MTGOSDK/packages" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="mtgosdk">
      <package pattern="MTGOSDK" />
      <package pattern="MTGOSDK.MSBuild" />
      <package pattern="MTGOSDK.Win32" />
    </packageSource>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
