<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>Latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Execution is driven through MTGO's UI Automation tree on purpose: it
         lets MTGO's own state machine own target legality, sequencing, and
         completion instead of this client re-implementing them. -->
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA2" Version="5.0.0" />
    <PackageReference Include="MTGOSDK"
                      Version="*" />
    <PackageReference Include="MTGOSDK.Win32"
                      Version="*" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime"
                      Version="1.30.0" />
  </ItemGroup>
</Project>
